+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Product;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class ProductAuthorizationTest extends TestCase
+{
+    use RefreshDatabase;
+
+    /** @return array<string, mixed> */
+    private function validPayload(array $overrides = []): array
+    {
+        return array_merge([
+            'name' => 'Detergente Líquido',
+            'description' => 'Bidón de 5 litros',
+            'category' => 'Detergentes',
+            'price' => 1250.00,
+            'stock' => 20,
+        ], $overrides);
+    }
+
+    public function test_a_guest_cannot_create_a_product(): void
+    {
+        $this->postJson('/api/products', $this->validPayload())
+            ->assertUnauthorized();
+
+        $this->assertDatabaseCount('products', 0);
+    }
+
+    public function test_a_guest_cannot_delete_a_product(): void
+    {
+        $product = Product::factory()->create();
+
+        $this->deleteJson('/api/products/'.$product->id)
+            ->assertUnauthorized();
+
+        $this->assertDatabaseHas('products', ['id' => $product->id]);
+    }
+
+    public function test_a_created_product_belongs_to_the_authenticated_user(): void
+    {
+        $user = User::factory()->create();
+
+        $this->actingAs($user, 'sanctum')
+            ->postJson('/api/products', $this->validPayload())
+            ->assertCreated();
+
+        $this->assertDatabaseHas('products', [
+            'name' => 'Detergente Líquido',
+            'user_id' => $user->id,
+        ]);
+    }
+
+    public function test_the_owner_cannot_be_spoofed_through_the_request_body(): void
+    {
+        $user = User::factory()->create();
+        $victim = User::factory()->create();
+
+        $this->actingAs($user, 'sanctum')
+            ->postJson('/api/products', $this->validPayload(['user_id' => $victim->id]))
+            ->assertCreated();
+
+        $this->assertDatabaseHas('products', ['user_id' => $user->id]);
+        $this->assertDatabaseMissing('products', ['user_id' => $victim->id]);
+    }
+
+    public function test_a_user_cannot_update_someone_elses_product(): void
+    {
+        $intruder = User::factory()->create();
+        $product = Product::factory()->create(['name' => 'Nombre original']);
+
+        $this->actingAs($intruder, 'sanctum')
+            ->putJson('/api/products/'.$product->id, $this->validPayload(['name' => 'Hackeado']))
+            ->assertForbidden();
+
+        $this->assertDatabaseHas('products', [
+            'id' => $product->id,
+            'name' => 'Nombre original',
+        ]);
+    }
+
+    public function test_a_user_cannot_delete_someone_elses_product(): void
+    {
+        $intruder = User::factory()->create();
+        $product = Product::factory()->create();
+
+        $this->actingAs($intruder, 'sanctum')
+            ->deleteJson('/api/products/'.$product->id)
+            ->assertForbidden();
+
+        $this->assertDatabaseHas('products', ['id' => $product->id]);
+    }
+
+    public function test_the_owner_can_delete_their_product(): void
+    {
+        $user = User::factory()->create();
+        $product = Product::factory()->for($user)->create();
+
+        $this->actingAs($user, 'sanctum')
+            ->deleteJson('/api/products/'.$product->id)
+            ->assertOk();
+
+        $this->assertDatabaseMissing('products', ['id' => $product->id]);
+    }
+
+    public function test_an_admin_can_update_any_product(): void
+    {
+        $admin = User::factory()->admin()->create();
+        $product = Product::factory()->create();
+
+        $this->actingAs($admin, 'sanctum')
+            ->putJson('/api/products/'.$product->id, $this->validPayload(['name' => 'Corregido por admin']))
+            ->assertOk();
+
+        $this->assertDatabaseHas('products', [
+            'id' => $product->id,
+            'name' => 'Corregido por admin',
+        ]);
+    }
+
+    public function test_an_admin_can_delete_any_product(): void
+    {
+        $admin = User::factory()->admin()->create();
+        $product = Product::factory()->create();
+
+        $this->actingAs($admin, 'sanctum')
+            ->deleteJson('/api/products/'.$product->id)
+            ->assertOk();
+
+        $this->assertDatabaseMissing('products', ['id' => $product->id]);
+    }
+
+    public function test_products_without_an_owner_are_only_manageable_by_admins(): void
+    {
+        $user = User::factory()->create();
+        $orphan = Product::factory()->create(['user_id' => null]);
+
+        $this->actingAs($user, 'sanctum')
+            ->deleteJson('/api/products/'.$orphan->id)
+            ->assertForbidden();
+
+        $admin = User::factory()->admin()->create();
+
+        $this->actingAs($admin, 'sanctum')
+            ->deleteJson('/api/products/'.$orphan->id)
+            ->assertOk();
+    }
+
+    public function test_registration_cannot_grant_the_admin_role(): void
+    {
+        $this->postJson('/api/register', [
+            'name' => 'Intruso',
+            'email' => 'intruso@example.com',
+            'password' => 'secret123',
+            'password_confirmation' => 'secret123',
+            'role' => 'admin',
+        ])->assertCreated();
+
+        $this->assertDatabaseHas('users', [
+            'email' => 'intruso@example.com',
+            'role' => 'user',
+        ]);
+    }
+
+    public function test_reading_products_stays_public(): void
+    {
+        Product::factory()->count(3)->create();
+
+        $this->getJson('/api/products')->assertOk();
+    }
+}
