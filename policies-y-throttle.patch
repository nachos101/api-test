+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class RateLimitTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_login_is_throttled_after_repeated_failures(): void
+    {
+        User::factory()->create(['email' => 'victima@example.com']);
+
+        $credentials = [
+            'email' => 'victima@example.com',
+            'password' => 'contrasena-incorrecta',
+        ];
+
+        // El limiter 'auth' permite 5 intentos por minuto y credencial.
+        for ($attempt = 1; $attempt <= 5; $attempt++) {
+            $this->postJson('/api/login', $credentials)
+                ->assertUnprocessable();
+        }
+
+        $this->postJson('/api/login', $credentials)
+            ->assertStatus(429);
+    }
+
+    public function test_the_throttle_does_not_leak_between_different_accounts(): void
+    {
+        $credentials = ['password' => 'contrasena-incorrecta'];
+
+        for ($attempt = 1; $attempt <= 5; $attempt++) {
+            $this->postJson('/api/login', $credentials + ['email' => 'uno@example.com'])
+                ->assertUnprocessable();
+        }
+
+        // Otra cuenta sigue pudiendo intentar: el bloqueo es por credencial,
+        // no global. (La cota por IP es de 20/min, todavía no se alcanza.)
+        $this->postJson('/api/login', $credentials + ['email' => 'dos@example.com'])
+            ->assertUnprocessable();
+    }
+
+    public function test_register_is_throttled(): void
+    {
+        for ($attempt = 1; $attempt <= 5; $attempt++) {
+            $this->postJson('/api/register', [
+                'name' => 'Usuario '.$attempt,
+                'email' => 'nuevo@example.com',
+                'password' => 'secret123',
+                'password_confirmation' => 'secret123',
+            ]);
+        }
+
+        $this->postJson('/api/register', [
+            'name' => 'Usuario 6',
+            'email' => 'nuevo@example.com',
+            'password' => 'secret123',
+            'password_confirmation' => 'secret123',
+        ])->assertStatus(429);
+    }
+
+    public function test_api_routes_expose_rate_limit_headers(): void
+    {
+        $this->getJson('/api/products')
+            ->assertOk()
+            ->assertHeader('X-RateLimit-Limit', 60);
+    }
+}
