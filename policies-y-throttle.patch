 namespace App\Providers;
 
+use App\Models\Product;
+use App\Policies\ProductPolicy;
+use Illuminate\Cache\RateLimiting\Limit;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\RateLimiter;
 use Illuminate\Support\ServiceProvider;
+use Illuminate\Support\Str;
 
 class AppServiceProvider extends ServiceProvider
 {
@@ -19,6 +26,36 @@ public function register(): void
      */
     public function boot(): void
     {
-        //
+        $this->registerPolicies();
+        $this->configureRateLimiting();
+    }
+
+    /**
+     * Laravel descubre las policies por convención, pero registrarlas
+     * explícitamente evita que un renombre silencioso deje todo sin autorizar.
+     */
+    private function registerPolicies(): void
+    {
+        Gate::policy(Product::class, ProductPolicy::class);
+    }
+
+    private function configureRateLimiting(): void
+    {
+        // Límite general de la API: por usuario si hay token, por IP si no.
+        RateLimiter::for('api', function (Request $request) {
+            return Limit::perMinute(60)->by($request->user()?->id ?: $request->ip());
+        });
+
+        // Límite estricto para login y registro. Dos cotas en simultáneo:
+        // una por credencial (frena fuerza bruta contra una cuenta) y otra
+        // por IP (frena el barrido de muchas cuentas desde un mismo origen).
+        RateLimiter::for('auth', function (Request $request) {
+            $email = Str::lower((string) $request->input('email'));
+
+            return [
+                Limit::perMinute(5)->by($email.'|'.$request->ip()),
+                Limit::perMinute(20)->by($request->ip()),
+            ];
+        });
     }
 }
