diff --git a/app/Policies/ProductPolicy.php b/app/Policies/ProductPolicy.php
new file mode 100644
index 0000000..d4cb577
--- /dev/null
+++ b/app/Policies/ProductPolicy.php
@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\Product;
+use App\Models\User;
+
+class ProductPolicy
+{
+    /**
+     * Lectura pública: el listado y el detalle no requieren autenticación,
+     * por eso estos métodos aceptan un usuario nulo.
+     */
+    public function viewAny(?User $user): bool
+    {
+        return true;
+    }
+
+    public function view(?User $user, Product $product): bool
+    {
+        return true;
+    }
+
+    /**
+     * Cualquier usuario autenticado puede cargar productos.
+     * Si mañana querés un catálogo centralizado, cambiás esto por
+     * $user->isAdmin() y el resto del sistema sigue funcionando igual.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    public function update(User $user, Product $product): bool
+    {
+        return $this->ownsOrIsAdmin($user, $product);
+    }
+
+    public function delete(User $user, Product $product): bool
+    {
+        return $this->ownsOrIsAdmin($user, $product);
+    }
+
+    private function ownsOrIsAdmin(User $user, Product $product): bool
+    {
+        if ($user->isAdmin()) {
+            return true;
+        }
+
+        // Los productos sin dueño (seeders, catálogo heredado) solo los
+        // administra un admin: null nunca debe coincidir con un usuario.
+        return $product->user_id !== null
+            && $product->user_id === $user->id;
+    }
+}
